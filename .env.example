# ─────────────────────────────────────────────────────────────────────────────
# IELTS Prep — template. Copy to .env and fill in.
# Read by: backend (./mvnw spring-boot:run, via spring.config.import) and docker compose.
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API key — paste it here, then restart the backend.
ANTHROPIC_API_KEY=

# Bootstrap admin, created on first start (stored as a BCrypt hash; change it later under Settings).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please

# Signs login tokens. Generated for this install; changing it logs everyone out.
# Leave blank to auto-generate (stored in data/.jwt-secret), or: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_HOURS=720

# Claude spend + models
CLAUDE_DAILY_SPEND_CAP_USD=3.00
CLAUDE_MODEL_GENERATION=claude-sonnet-5
CLAUDE_MODEL_VERIFICATION=claude-sonnet-5
CLAUDE_MODEL_GRADING=claude-sonnet-5
CLAUDE_MODEL_COACHING=claude-sonnet-5
CLAUDE_MODEL_EXAMINER=claude-sonnet-5
CLAUDE_MODEL_FAST=claude-haiku-4-5

# Local timezone (daily spend cap and study-plan days roll over at local midnight)
TZ=UTC

# Speaking transcription: BROWSER (Web Speech API) or WHISPER (set WHISPER_URL + WHISPER_API_KEY)
SPEAKING_TRANSCRIPTION=BROWSER
WHISPER_URL=
WHISPER_API_KEY=

# Docker ports (root docker-compose.yml)
FRONTEND_PORT=3000
BACKEND_PORT=8090
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
